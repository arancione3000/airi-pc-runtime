#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BASE="${AIRIPC_WORKSPACE_ROOT:-${AIRI_WORKSPACE_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}}"
export AIRIPC_WORKSPACE_ROOT="$BASE"
VENV="${AIRIPC_VENV:-$BASE/.venv}"
exec "$VENV/bin/python" "$BASE/computer/control_plane/supervisor.py" "$@"
